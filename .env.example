# --- Starling -----------------------------------------------------------------
# A Starling personal access token is scoped to ONE account holder, and personal vs
# business are separate account holders. So list one profile name per token you need.
# Names are arbitrary; they only label things in logs, /discover and the mapping file.
STARLING_ACCOUNTS=primary,secondary

# For each name above, set STARLING_<NAME>_TOKEN and STARLING_<NAME>_WEBHOOK_PUBLIC_KEY.
# Token scopes needed: account:read, transaction:read, space:read
#   (savings-goal:read instead of space:read on older accounts)
# The webhook public key (base64 DER/SPKI) is shown next to the webhook you register in the
# developer portal. Starling's V2 webhook security signs payloads with the *private* half of
# that key pair (SHA512withRSA) — this is not a shared HMAC secret, despite the name Starling
# uses for the field on older docs/UI.
STARLING_PRIMARY_TOKEN=
STARLING_PRIMARY_WEBHOOK_PUBLIC_KEY=

STARLING_SECONDARY_TOKEN=
STARLING_SECONDARY_WEBHOOK_PUBLIC_KEY=

# Optional, per profile: enables detecting a payment between two of your OWN Starling accounts
# (different main accounts, or a Space under a different main account) as a transfer. Starling
# marks these `source: "ON_US_PAY_ME"`/`counterPartyType: "CUSTOMER"` rather than the
# same-account `INTERNAL_TRANSFER`/`CATEGORY` pair, which is detected without this — find your
# own value by inspecting a real such payment's feed item (counterPartyUid is the same on both
# legs, regardless of account or direction).
STARLING_PRIMARY_SELF_CUSTOMER_UID=

# --- Actual Budget ------------------------------------------------------------
ACTUAL_SERVER_URL=https://actual.rafu.moe
ACTUAL_SERVER_PASSWORD=
# Settings -> Advanced -> Sync ID (a UUID, not the budget name)
ACTUAL_SYNC_ID=
# Only if the budget file is end-to-end encrypted
ACTUAL_BUDGET_PASSWORD=

# --- Optional -----------------------------------------------------------------
# An Actual budget is single-currency. Feed items in any other currency are refused
# rather than imported at face value, so a EUR account can't silently corrupt a GBP budget.
BUDGET_CURRENCY=GBP

PORT=3000
ACTUAL_DATA_DIR=./.actual-cache
MAPPING_PATH=./config/mapping.json
STARLING_TIMEZONE=Europe/London

# docker-compose.yml only: published host port. PORT above stays pinned to 3000
# *inside* the container regardless of what's set here.
HOST_PORT=3000
